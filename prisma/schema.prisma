datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  user_id           String                   @id @default(uuid()) @db.Uuid
  phone_number      String                   @unique
  name              String?
  email             String?
  status            String                   @default("Active") // Active | Inactive | Blocked
  fcm_token         String?
  total_bookings    Int                      @default(0)
  total_spend       Decimal                  @default(0.0) @db.Decimal(10, 2)
  created_at        DateTime                 @default(now()) @db.Timestamptz
  
  bookings          Booking[]
  wishlists         Wishlist[]
  oauth_identities  OAuthIdentity[]
  user_milestones   UserMilestone[]
  registrations     TournamentRegistration[]
  reviews           VenueReview[]

  @@map("users")
}

model Partner {
  partner_id        String            @id @default(uuid()) @db.Uuid
  phone_number      String            @unique
  email             String?           @unique
  kyc_status        String            @default("unverified") // unverified | pending | verified | rejected
  plan_tier         String            @default("free")
  total_earnings    Decimal           @default(0.0) @db.Decimal(10, 2)
  fcm_token         String?
  created_at        DateTime          @default(now()) @db.Timestamptz

  venues            Venue[]
  partner_documents PartnerDocument[]
  settlements       Settlement[]

  @@map("partners")
}

model Venue {
  venue_id          String         @id @default(uuid()) @db.Uuid
  partner_id        String         @db.Uuid
  name              String
  sport_types       String[]
  status            String         @default("unlisted") // unlisted | listed | suspended
  avg_rating        Decimal        @default(0.0) @db.Decimal(3, 2)
  base_price        Decimal        @db.Decimal(10, 2)
  slot_mode         String         @default("60m")
  created_at        DateTime       @default(now()) @db.Timestamptz
  amenities         String[]       @default([])
  images            String[]       @default([])
  address           String?
  contact_phone     String?
  latitude          Decimal?       @db.Decimal(10, 8)
  longitude         Decimal?       @db.Decimal(11, 8)

  partner           Partner        @relation(fields: [partner_id], references: [partner_id], onDelete: Cascade)
  slots             Slot[]
  bookings          Booking[]
  reviews           VenueReview[]
  wishlists         Wishlist[]
  tournaments       Tournament[]

  @@map("venues")
}

model Slot {
  slot_id           String    @id @default(uuid()) @db.Uuid
  venue_id          String    @db.Uuid
  date              DateTime  @db.Date
  start_time        String
  end_time          String
  price             Decimal   @db.Decimal(10, 2)
  status            String    @default("available") // available | booked | blocked_by_partner | blocked_by_admin
  demand_tag        String?

  venue             Venue     @relation(fields: [venue_id], references: [venue_id], onDelete: Cascade)
  bookings          Booking[]

  @@map("slots")
}

model Booking {
  booking_id        String        @id @default(uuid()) @db.Uuid
  user_id           String        @db.Uuid
  venue_id          String        @db.Uuid
  slot_id           String        @db.Uuid
  status            String        @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  payment_mode      String        // card | upi | pay_at_venue | free
  eticket_code      String        @unique // APV-2026-XXXXXX
  convenience_fee   Decimal       @db.Decimal(10, 2)
  commission_amount Decimal       @db.Decimal(10, 2)
  gst_amount        Decimal       @db.Decimal(10, 2)
  partner_amount    Decimal       @db.Decimal(10, 2)
  online_amount     Decimal       @db.Decimal(10, 2)
  venue_amount      Decimal       @db.Decimal(10, 2)
  created_at        DateTime      @default(now()) @db.Timestamptz

  user              User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  venue             Venue         @relation(fields: [venue_id], references: [venue_id], onDelete: Cascade)
  slot              Slot          @relation(fields: [slot_id], references: [slot_id], onDelete: Cascade)
  transactions      Transaction[]
  disputes          Dispute[]
  reviews           VenueReview[]

  @@map("bookings")
}

model Transaction {
  txn_id             String   @id @default(uuid()) @db.Uuid
  booking_id         String   @db.Uuid
  razorpay_order_id  String
  razorpay_payment_id String?
  txn_type           String   // capture | refund
  txn_status         String
  amount             Decimal  @db.Decimal(10, 2)
  created_at         DateTime @default(now()) @db.Timestamptz

  booking            Booking  @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)

  @@map("transactions")
}

model Settlement {
  settlement_id     String   @id @default(uuid()) @db.Uuid
  partner_id        String   @db.Uuid
  period_start      DateTime @db.Timestamptz
  period_end        DateTime @db.Timestamptz
  gross_amount      Decimal  @db.Decimal(10, 2)
  platform_fee      Decimal  @db.Decimal(10, 2)
  net_amount        Decimal  @db.Decimal(10, 2)
  status            String   @default("calculating") // calculating | pending | on_hold | settled | failed
  created_at        DateTime @default(now()) @db.Timestamptz

  partner           Partner  @relation(fields: [partner_id], references: [partner_id], onDelete: Cascade)

  @@map("settlements")
}

model Dispute {
  dispute_id        String   @id @default(uuid()) @db.Uuid
  booking_id        String   @db.Uuid
  raised_by         String   // user | partner
  status            String   @default("open") // open | under_review | resolved | escalated
  resolution        String?  // refund_user | warn_partner | closed_no_action | escalated
  details           String

  booking            Booking  @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)

  @@map("disputes")
}

model RefreshToken {
  token_id          String    @id @default(uuid()) @db.Uuid
  user_id           String    @db.Uuid
  role              String    // user | partner | admin
  token_hash        String
  device_info       String?
  fcm_token         String?
  revoked_at        DateTime? @db.Timestamptz
  expires_at        DateTime  @db.Timestamptz

  @@map("refresh_tokens")
}

model OtpLog {
  otp_id            String   @id @default(uuid()) @db.Uuid
  phone_number      String
  otp_hash          String
  expires_at        DateTime @db.Timestamptz
  attempt_count     Int      @default(0)

  @@map("otp_log")
}

model OAuthIdentity {
  oauth_id          String @id @default(uuid()) @db.Uuid
  user_id           String @db.Uuid
  provider          String // google | apple
  provider_user_id  String

  user              User   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("oauth_identities")
}

model VenueReview {
  review_id         String  @id @default(uuid()) @db.Uuid
  venue_id          String  @db.Uuid
  user_id           String  @db.Uuid
  booking_id        String  @db.Uuid
  rating            Int
  comment           String
  reply             String?

  venue             Venue   @relation(fields: [venue_id], references: [venue_id], onDelete: Cascade)
  user              User    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  booking           Booking @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)

  @@map("venue_reviews")
}

model Wishlist {
  wishlist_id       String @id @default(uuid()) @db.Uuid
  user_id           String @db.Uuid
  venue_id          String @db.Uuid

  user              User   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  venue             Venue  @relation(fields: [venue_id], references: [venue_id], onDelete: Cascade)

  @@unique([user_id, venue_id])
  @@map("wishlists")
}

model Tournament {
  tournament_id     String   @id @default(uuid()) @db.Uuid
  venue_id          String   @db.Uuid
  name              String
  sport_type        String
  registration_fee  Decimal  @db.Decimal(10, 2)
  status            String   @default("upcoming") // upcoming | open | full | completed | cancelled
  max_participants  Int

  venue             Venue    @relation(fields: [venue_id], references: [venue_id], onDelete: Cascade)
  registrations     TournamentRegistration[]

  @@map("tournaments")
}

model TournamentRegistration {
  reg_id            String     @id @default(uuid()) @db.Uuid
  tournament_id     String     @db.Uuid
  user_id           String     @db.Uuid
  team_name         String
  payment_status    String

  tournament        Tournament @relation(fields: [tournament_id], references: [tournament_id], onDelete: Cascade)
  user              User       @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("tournament_registrations")
}

model NotificationBroadcast {
  broadcast_id      String   @id @default(uuid()) @db.Uuid
  audience_type     String
  title             String
  body              String
  status            String
  sent_at           DateTime @default(now()) @db.Timestamptz

  @@map("notification_broadcasts")
}

model UserNotification {
  notif_id          String   @id @default(uuid()) @db.Uuid
  recipient_id      String   @db.Uuid
  recipient_type    String   // user | partner
  category          String   // booking | kyc | settlement | alert
  title             String
  body              String
  is_read           Boolean  @default(false)
  created_at        DateTime @default(now()) @db.Timestamptz

  @@map("user_notifications")
}

model Coupon {
  coupon_id         String          @id @default(uuid()) @db.Uuid
  code              String          @unique
  discount_type     String          // percent | flat
  discount_value    Decimal         @db.Decimal(10, 2)
  max_discount      Decimal?        @db.Decimal(10, 2)
  min_order_value   Decimal         @default(0.0) @db.Decimal(10, 2)
  usage_limit       Int
  per_user_limit    Int             @default(1)
  is_active         Boolean         @default(true)
  valid_from        DateTime        @db.Timestamptz
  valid_until       DateTime        @db.Timestamptz

  milestones        UserMilestone[]

  @@map("coupons")
}

model PartnerDocument {
  doc_id            String   @id @default(uuid()) @db.Uuid
  partner_id        String   @db.Uuid
  document_type     String   // gst_certificate | pan_card | ownership_proof
  file_url          String
  status            String   @default("pending") // pending | verified | rejected
  rejection_note    String?

  partner           Partner  @relation(fields: [partner_id], references: [partner_id], onDelete: Cascade)

  @@map("partner_documents")
}

model Banner {
  banner_id         String   @id @default(uuid()) @db.Uuid
  title             String
  image_url         String
  link_url          String?
  target_app        String   // user | partner | all
  display_order     Int
  is_active         Boolean  @default(true)

  @@map("banners")
}

model UserMilestone {
  milestone_id      String   @id @default(uuid()) @db.Uuid
  user_id           String   @db.Uuid
  milestone_type    String
  coupon_id         String   @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz

  user              User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  coupon            Coupon   @relation(fields: [coupon_id], references: [coupon_id], onDelete: Cascade)

  @@map("user_milestones")
}

model ChatMessage {
  message_id   String   @id @default(uuid()) @db.Uuid
  sender_id    String   @db.Uuid
  sender_role  String   // user | partner | admin
  recipient_id String   @db.Uuid
  text         String
  created_at   DateTime @default(now()) @db.Timestamptz

  @@map("chat_messages")
}

