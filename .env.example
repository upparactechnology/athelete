# Athlete POV backend — variable names and safe placeholders ONLY.
# Never commit real credentials. Copy to .env and fill locally.
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/athletepov
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ALLOWED_ORIGINS=
NODE_ENV=development
# Google Sign-In audience (backend verifies ID tokens against these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
# OTP behaviour (dev echo requires OTP_DEV_MODE=true and never runs in production)
OTP_DEV_MODE=false
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Razorpay (env takes precedence over Redis system_settings)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Dev-only simulated payments. NEVER true in production.
ALLOW_MOCK_PAYMENTS=false
